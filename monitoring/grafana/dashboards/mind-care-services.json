{
  "dashboard": {
    "title": "Mind Care Services Monitoring",
    "description": "Monitoring dashboard for Lost Item and Followup Alert services",
    "tags": ["mind-care", "services"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "JVM Memory Usage - Lost Item Service",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 0
        },
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{instance=\"lost-item-service:8080\"}",
            "legendFormat": "{{ area }}"
          }
        ],
        "yaxes": [
          {
            "format": "bytes",
            "label": "Memory Usage"
          }
        ]
      },
      {
        "id": 2,
        "title": "JVM Memory Usage - Followup Alert Service",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 0
        },
        "targets": [
          {
            "expr": "jvm_memory_used_bytes{instance=\"followup-alert-service:8080\"}",
            "legendFormat": "{{ area }}"
          }
        ],
        "yaxes": [
          {
            "format": "bytes",
            "label": "Memory Usage"
          }
        ]
      },
      {
        "id": 3,
        "title": "HTTP Requests - Lost Item Service",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{instance=\"lost-item-service:8080\"}[1m])",
            "legendFormat": "{{ method }} {{ uri }}"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 4,
        "title": "HTTP Requests - Followup Alert Service",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 8
        },
        "targets": [
          {
            "expr": "rate(http_server_requests_seconds_count{instance=\"followup-alert-service:8080\"}[1m])",
            "legendFormat": "{{ method }} {{ uri }}"
          }
        ],
        "yaxes": [
          {
            "format": "reqps",
            "label": "Requests/sec"
          }
        ]
      },
      {
        "id": 5,
        "title": "HTTP Request Duration - Lost Item Service",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 0,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{instance=\"lost-item-service:8080\"}[1m]))",
            "legendFormat": "p95 {{ uri }}"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration (seconds)"
          }
        ]
      },
      {
        "id": 6,
        "title": "HTTP Request Duration - Followup Alert Service",
        "type": "graph",
        "gridPos": {
          "h": 8,
          "w": 12,
          "x": 12,
          "y": 16
        },
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_server_requests_seconds_bucket{instance=\"followup-alert-service:8080\"}[1m]))",
            "legendFormat": "p95 {{ uri }}"
          }
        ],
        "yaxes": [
          {
            "format": "s",
            "label": "Duration (seconds)"
          }
        ]
      }
    ],
    "refresh": "10s",
    "schemaVersion": 27,
    "version": 1
  },
  "overwrite": true
}
