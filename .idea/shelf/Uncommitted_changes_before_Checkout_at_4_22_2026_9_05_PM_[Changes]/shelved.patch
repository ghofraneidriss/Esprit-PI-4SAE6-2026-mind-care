-            }
-        }
-
-        MovementAlert alert = MovementAlert.builder()
-                .patientId(patientId)
-                .alertType(type)
-                .severity(severity)
-                .message(text)
-                .acknowledged(false)
-                .emailSent(false)
-                .createdAt(LocalDateTime.now())
-                .build();
