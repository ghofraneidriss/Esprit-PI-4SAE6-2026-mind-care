<+>package tn.esprit.recommendation_service.service;\r\n\r\nimport com.fasterxml.jackson.databind.ObjectMapper;\r\nimport org.junit.jupiter.api.BeforeEach;\r\nimport org.junit.jupiter.api.DisplayName;\r\nimport org.junit.jupiter.api.Nested;\r\nimport org.junit.jupiter.api.Test;\r\nimport org.junit.jupiter.api.extension.ExtendWith;\r\nimport org.mockito.InjectMocks;\r\nimport org.mockito.Mock;\r\nimport org.mockito.junit.jupiter.MockitoExtension;\r\nimport tn.esprit.recommendation_service.dto.sudoku.SudokuCreateRequest;\r\nimport tn.esprit.recommendation_service.dto.sudoku.SudokuResponse;\r\nimport tn.esprit.recommendation_service.dto.sudoku.SudokuSessionStartResponse;\r\nimport tn.esprit.recommendation_service.dto.sudoku.SudokuSessionSubmitRequest;\r\nimport tn.esprit.recommendation_service.dto.sudoku.SudokuSessionResponse;\r\nimport tn.esprit.recommendation_service.entity.MedicalEvent;\r\nimport tn.esprit.recommendation_service.entity.SudokuGame;\r\nimport tn.esprit.recommendation_service.entity.SudokuSession;\r\nimport tn.esprit.recommendation_service.enums.DifficultyLevel;\r\nimport tn.esprit.recommendation_service.enums.MedicalEventStatus;\r\nimport tn.esprit.recommendation_service.enums.MedicalEventType;\r\nimport tn.esprit.recommendation_service.exception.BusinessException;\r\nimport tn.esprit.recommendation_service.exception.ResourceNotFoundException;\r\nimport tn.esprit.recommendation_service.repository.MedicalEventRepository;\r\nimport tn.esprit.recommendation_service.repository.SudokuGameRepository;\r\nimport tn.esprit.recommendation_service.repository.SudokuSessionRepository;\r\n\r\nimport java.time.LocalDateTime;\r\nimport java.util.List;\r\nimport java.util.Optional;\r\n\r\nimport static org.assertj.core.api.Assertions.assertThat;\r\nimport static org.assertj.core.api.Assertions.assertThatThrownBy;\r\nimport static org.mockito.ArgumentMatchers.any;\r\nimport static org.mockito.Mockito.*;\r\n\r\n@ExtendWith(MockitoExtension.class)\r\n@DisplayName(\"SudokuService — Tests Unitaires\")\r\nclass SudokuServiceTest {\r\n\r\n    @Mock private SudokuGameRepository sudokuGameRepository;\r\n    @Mock private SudokuSessionRepository sudokuSessionRepository;\r\n    @Mock private MedicalEventRepository medicalEventRepository;\r\n    @Mock private ObjectMapper objectMapper;\r\n\r\n    @InjectMocks\r\n    private SudokuService sudokuService;\r\n\r\n    private MedicalEvent sampleEvent;\r\n    private SudokuGame sampleGame;\r\n\r\n    @BeforeEach\r\n    void setUp() throws Exception {\r\n        sampleEvent = MedicalEvent.builder()\r\n                .id(10L).title(\"Sudoku thérapeutique\")\r\n                .type(MedicalEventType.SUDOKU).difficulty(DifficultyLevel.EASY)\r\n                .status(MedicalEventStatus.ACTIVE).patientId(4L)\r\n                .startDate(LocalDateTime.now()).endDate(LocalDateTime.now().plusDays(30))\r\n                .autoGenerated(false).build();\r\n\r\n        sampleGame = SudokuGame.builder()\r\n                .id(1L).medicalEvent(sampleEvent).patientId(4L)\r\n                .difficulty(DifficultyLevel.EASY).gridSize(4)\r\n                .puzzle(\"[[1,2,0,4],[3,0,1,2],[2,1,4,3],[4,3,2,0]]\")\r\n                .solution(\"[[1,2,3,4],[3,4,1,2],[2,1,4,3],[4,3,2,1]]\")\r\n                .timeLimitSeconds(300).active(true).completedSessions(0).build();\r\n\r\n        when(objectMapper.writeValueAsString(any())).thenReturn(\"[[1,2,3,4]]\");\r\n    }\r\n\r\n    // ── Génération de grille ──────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"Génération de grille Sudoku\")\r\n    class GridGeneration {\r\n\r\n        @Test\r\n        @DisplayName(\"generateSolution(4) produit une grille 4x4 valide\")\r\n        void generateSolution_4x4_isValid() {\r\n            int[][] grid = sudokuService.generateSolution(4);\r\n\r\n            assertThat(grid).hasNumberOfRows(4);\r\n            assertThat(grid[0]).hasSize(4);\r\n\r\n            // Chaque ligne contient 1,2,3,4\r\n            for (int[] row : grid) {\r\n                assertThat(row).containsExactlyInAnyOrder(1, 2, 3, 4);\r\n            }\r\n\r\n            // Chaque colonne contient 1,2,3,4\r\n            for (int col = 0; col < 4; col++) {\r\n                int[] column = new int[4];\r\n                for (int row = 0; row < 4; row++) column[row] = grid[row][col];\r\n                assertThat(column).containsExactlyInAnyOrder(1, 2, 3, 4);\r\n            }\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"generateSolution(4) — chaque sous-grille 2x2 contient 1,2,3,4\")\r\n        void generateSolution_4x4_subGridsValid() {\r\n            int[][] grid = sudokuService.generateSolution(4);\r\n\r\n            // Sous-grille haut-gauche\r\n            assertThat(new int[]{grid[0][0], grid[0][1], grid[1][0], grid[1][1]})\r\n                    .containsExactlyInAnyOrder(1, 2, 3, 4);\r\n            // Sous-grille haut-droite\r\n            assertThat(new int[]{grid[0][2], grid[0][3], grid[1][2], grid[1][3]})\r\n                    .containsExactlyInAnyOrder(1, 2, 3, 4);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"generatePuzzle EASY retire exactement 6 cellules\")\r\n        void generatePuzzle_easy_removes6Cells() {\r\n            int[][] solution = sudokuService.generateSolution(4);\r\n            int[][] puzzle = sudokuService.generatePuzzle(solution, DifficultyLevel.EASY);\r\n\r\n            int zeroCount = 0;\r\n            for (int[] row : puzzle) {\r\n                for (int cell : row) {\r\n                    if (cell == 0) zeroCount++;\r\n                }\r\n            }\r\n            assertThat(zeroCount).isEqualTo(6);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"isValid retourne false si doublon dans la ligne\")\r\n        void isValid_duplicateInRow_returnsFalse() {\r\n            int[][] grid = new int[4][4];\r\n            grid[0][0] = 1;\r\n            assertThat(sudokuService.isValid(grid, 0, 1, 1, 4)).isFalse();\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"isValid retourne false si doublon dans la colonne\")\r\n        void isValid_duplicateInColumn_returnsFalse() {\r\n            int[][] grid = new int[4][4];\r\n            grid[0][0] = 2;\r\n            assertThat(sudokuService.isValid(grid, 1, 0, 2, 4)).isFalse();\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"isValid retourne true si placement valide\")\r\n        void isValid_validPlacement_returnsTrue() {\r\n            int[][] grid = new int[4][4];\r\n            assertThat(sudokuService.isValid(grid, 0, 0, 1, 4)).isTrue();\r\n        }\r\n    }\r\n\r\n    // ── createGame ────────────────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"createGame\")\r\n    class CreateGame {\r\n\r\n        @Test\r\n        @DisplayName(\"Crée un jeu Sudoku EASY avec succès\")\r\n        void createGame_easy_success() {\r\n            SudokuCreateRequest request = SudokuCreateRequest.builder()\r\n                    .patientId(4L).difficulty(DifficultyLevel.EASY)\r\n                    .timeLimitSeconds(300).title(\"Sudoku test\").build();\r\n\r\n            when(medicalEventRepository.save(any())).thenReturn(sampleEvent);\r\n            when(sudokuGameRepository.save(any())).thenReturn(sampleGame);\r\n\r\n            SudokuResponse response = sudokuService.createGame(request);\r\n\r\n            assertThat(response).isNotNull();\r\n            assertThat(response.getPatientId()).isEqualTo(4L);\r\n            assertThat(response.getGridSize()).isEqualTo(4);\r\n            assertThat(response.getDifficulty()).isEqualTo(DifficultyLevel.EASY);\r\n            verify(medicalEventRepository).save(argThat(e ->\r\n                    e.getType() == MedicalEventType.SUDOKU &&\r\n                    e.getStatus() == MedicalEventStatus.ACTIVE));\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si patientId est null\")\r\n        void createGame_nullPatientId_throws() {\r\n            SudokuCreateRequest request = SudokuCreateRequest.builder()\r\n                    .patientId(null).difficulty(DifficultyLevel.EASY).build();\r\n\r\n            assertThatThrownBy(() -> sudokuService.createGame(request))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"patientId\");\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si patientId <= 0\")\r\n        void createGame_zeroPatientId_throws() {\r\n            SudokuCreateRequest request = SudokuCreateRequest.builder()\r\n                    .patientId(0L).difficulty(DifficultyLevel.EASY).build();\r\n\r\n            assertThatThrownBy(() -> sudokuService.createGame(request))\r\n                    .isInstanceOf(BusinessException.class);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"gridSize = 4 pour EASY\")\r\n        void createGame_easy_gridSizeIs4() {\r\n            SudokuCreateRequest request = SudokuCreateRequest.builder()\r\n                    .patientId(4L).difficulty(DifficultyLevel.EASY).build();\r\n            when(medicalEventRepository.save(any())).thenReturn(sampleEvent);\r\n            when(sudokuGameRepository.save(any())).thenReturn(sampleGame);\r\n\r\n            sudokuService.createGame(request);\r\n\r\n            verify(sudokuGameRepository).save(argThat(g -> g.getGridSize() == 4));\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"timeLimitSeconds par défaut = 300 si non fourni\")\r\n        void createGame_defaultTimeLimit() {\r\n            SudokuCreateRequest request = SudokuCreateRequest.builder()\r\n                    .patientId(4L).difficulty(DifficultyLevel.EASY)\r\n                    .timeLimitSeconds(null).build();\r\n            when(medicalEventRepository.save(any())).thenReturn(sampleEvent);\r\n            when(sudokuGameRepository.save(any())).thenReturn(sampleGame);\r\n\r\n            sudokuService.createGame(request);\r\n\r\n            verify(sudokuGameRepository).save(argThat(g -> g.getTimeLimitSeconds() == 300));\r\n        }\r\n    }\r\n\r\n    // ── getByEvent ────────────────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"getByEvent\")\r\n    class GetByEvent {\r\n\r\n        @Test\r\n        @DisplayName(\"Retourne le jeu si l'eventId existe\")\r\n        void getByEvent_found() {\r\n            when(sudokuGameRepository.findByMedicalEvent_Id(10L)).thenReturn(Optional.of(sampleGame));\r\n            when(sudokuSessionRepository.findBySudokuGame_IdAndCompletedTrueOrderByScoreDescDurationSecondsAsc(1L))\r\n                    .thenReturn(List.of());\r\n\r\n            SudokuResponse response = sudokuService.getByEvent(10L);\r\n\r\n            assertThat(response.getMedicalEventId()).isEqualTo(10L);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève ResourceNotFoundException si eventId inconnu\")\r\n        void getByEvent_notFound() {\r\n            when(sudokuGameRepository.findByMedicalEvent_Id(99L)).thenReturn(Optional.empty());\r\n\r\n            assertThatThrownBy(() -> sudokuService.getByEvent(99L))\r\n                    .isInstanceOf(ResourceNotFoundException.class)\r\n                    .hasMessageContaining(\"99\");\r\n        }\r\n    }\r\n\r\n    // ── startSession ──────────────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"startSession\")\r\n    class StartSession {\r\n\r\n        @Test\r\n        @DisplayName(\"Démarre une session avec succès\")\r\n        void startSession_success() {\r\n            SudokuSession session = SudokuSession.builder()\r\n                    .id(1L).sudokuGame(sampleGame).patientId(4L)\r\n                    .startedAt(LocalDateTime.now()).completed(false).abandoned(false)\r\n                    .errorsCount(0).hintsUsed(0).completionPercent(0).build();\r\n\r\n            when(sudokuGameRepository.findById(1L)).thenReturn(Optional.of(sampleGame));\r\n            when(sudokuSessionRepository.save(any())).thenReturn(session);\r\n\r\n            SudokuSessionStartResponse response = sudokuService.startSession(1L, 4L);\r\n\r\n            assertThat(response.getSessionId()).isEqualTo(1L);\r\n            assertThat(response.getPatientId()).isEqualTo(4L);\r\n            verify(sudokuSessionRepository).save(argThat(s ->\r\n                    s.getPatientId().equals(4L) &&\r\n                    !s.getCompleted() && !s.getAbandoned()));\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève ResourceNotFoundException si gameId inconnu\")\r\n        void startSession_gameNotFound() {\r\n            when(sudokuGameRepository.findById(99L)).thenReturn(Optional.empty());\r\n\r\n            assertThatThrownBy(() -> sudokuService.startSession(99L, 4L))\r\n                    .isInstanceOf(ResourceNotFoundException.class);\r\n        }\r\n    }\r\n\r\n    // ── submitSession ─────────────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"submitSession\")\r\n    class SubmitSession {\r\n\r\n        private SudokuSession openSession;\r\n\r\n        @BeforeEach\r\n        void setUpSession() {\r\n            openSession = SudokuSession.builder()\r\n                    .id(5L).sudokuGame(sampleGame).patientId(4L)\r\n                    .startedAt(LocalDateTime.now().minusMinutes(3))\r\n                    .completed(false).abandoned(false)\r\n                    .errorsCount(0).hintsUsed(0).completionPercent(0).build();\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Soumet une session complétée et calcule le score\")\r\n        void submitSession_completed_calculatesScore() {\r\n            SudokuSessionSubmitRequest request = SudokuSessionSubmitRequest.builder()\r\n                    .patientId(4L).durationSeconds(180).errorsCount(0)\r\n                    .hintsUsed(0).completionPercent(100).completed(true).abandoned(false).build();\r\n\r\n            when(sudokuGameRepository.findById(1L)).thenReturn(Optional.of(sampleGame));\r\n            when(sudokuSessionRepository.findById(5L)).thenReturn(Optional.of(openSession));\r\n            when(sudokuSessionRepository.save(any())).thenAnswer(inv -> inv.getArgument(0));\r\n            when(sudokuGameRepository.save(any())).thenReturn(sampleGame);\r\n\r\n            SudokuSessionResponse response = sudokuService.submitSession(1L, 5L, request);\r\n\r\n            assertThat(response.getCompleted()).isTrue();\r\n            assertThat(response.getScore()).isGreaterThan(0);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Score = 0 si session abandonnée\")\r\n        void submitSession_abandoned_scoreIsZero() {\r\n            SudokuSessionSubmitRequest request = SudokuSessionSubmitRequest.builder()\r\n                    .patientId(4L).durationSeconds(60).errorsCount(2)\r\n                    .hintsUsed(1).completionPercent(50).completed(false).abandoned(true).build();\r\n\r\n            when(sudokuGameRepository.findById(1L)).thenReturn(Optional.of(sampleGame));\r\n            when(sudokuSessionRepository.findById(5L)).thenReturn(Optional.of(openSession));\r\n            when(sudokuSessionRepository.save(any())).thenAnswer(inv -> inv.getArgument(0));\r\n\r\n            SudokuSessionResponse response = sudokuService.submitSession(1L, 5L, request);\r\n\r\n            assertThat(response.getScore()).isEqualTo(0);\r\n            assertThat(response.getAbandoned()).isTrue();\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si session déjà soumise\")\r\n        void submitSession_alreadySubmitted_throws() {\r\n            openSession.setFinishedAt(LocalDateTime.now());\r\n            SudokuSessionSubmitRequest request = SudokuSessionSubmitRequest.builder()\r\n                    .patientId(4L).completed(true).abandoned(false).build();\r\n\r\n            when(sudokuGameRepository.findById(1L)).thenReturn(Optional.of(sampleGame));\r\n            when(sudokuSessionRepository.findById(5L)).thenReturn(Optional.of(openSession));\r\n\r\n            assertThatThrownBy(() -> sudokuService.submitSession(1L, 5L, request))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"already been submitted\");\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si patientId ne correspond pas\")\r\n        void submitSession_wrongPatient_throws() {\r\n            SudokuSessionSubmitRequest request = SudokuSessionSubmitRequest.builder()\r\n                    .patientId(99L).completed(true).abandoned(false).build();\r\n\r\n            when(sudokuGameRepository.findById(1L)).thenReturn(Optional.of(sampleGame));\r\n            when(sudokuSessionRepository.findById(5L)).thenReturn(Optional.of(openSession));\r\n\r\n            assertThatThrownBy(() -> sudokuService.submitSession(1L, 5L, request))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"patient\");\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Met à jour bestScore si score supérieur\")\r\n        void submitSession_updatesBestScore() {\r\n            sampleGame.setBestScore(100);\r\n            SudokuSessionSubmitRequest request = SudokuSessionSubmitRequest.builder()\r\n                    .patientId(4L).durationSeconds(100).errorsCount(0)\r\n                    .hintsUsed(0).completionPercent(100).completed(true).abandoned(false).build();\r\n\r\n            when(sudokuGameRepository.findById(1L)).thenReturn(Optional.of(sampleGame));\r\n            when(sudokuSessionRepository.findById(5L)).thenReturn(Optional.of(openSession));\r\n            when(sudokuSessionRepository.save(any())).thenAnswer(inv -> inv.getArgument(0));\r\n            when(sudokuGameRepository.save(any())).thenReturn(sampleGame);\r\n\r\n            sudokuService.submitSession(1L, 5L, request);\r\n\r\n            verify(sudokuGameRepository).save(argThat(g -> g.getBestScore() >= 100));\r\n        }\r\n    }\r\n}\r\n
