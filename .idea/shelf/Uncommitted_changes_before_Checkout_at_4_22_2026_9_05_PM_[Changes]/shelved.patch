-    private int priorityFor(PatientLevel level, int basePriority) {
-        if (level == null) {
-            return basePriority;
-        }
-        return switch (level) {
-            case LOW -> Math.max(1, basePriority - 1);
-            case MEDIUM -> basePriority;
-            case HIGH -> Math.min(10, basePriority + 1);
-        };
-    }
