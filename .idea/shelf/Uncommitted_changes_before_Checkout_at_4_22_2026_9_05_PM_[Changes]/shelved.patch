.assertThat;\r\nimport static org.assertj.core.api.Assertions.assertThatThrownBy;\r\nimport static org.mockito.ArgumentMatchers.any;\r\nimport static org.mockito.ArgumentMatchers.anyString;\r\nimport static org.mockito.ArgumentMatchers.eq;\r\nimport static org.mockito.Mockito.*;\r\n\r\n@ExtendWith(MockitoExtension.class)\r\n@DisplayName(\"SouvenirPuzzleService — Tests Unitaires\")\r\nclass SouvenirPuzzleServiceTest {\r\n\r\n    @Mock private SouvenirPuzzleRepository souvenirPuzzleRepository;\r\n    @Mock private PuzzleSessionRepository puzzleSessionRepository;\r\n    @Mock private MedicalEventRepository medicalEventRepository;\r\n    @Mock private MedicalEventParticipationRepository participationRepository;\r\n    @Mock private PatientStatsService patientStatsService;\r\n    @Mock private RestTemplate restTemplate;\r\n\r\n    @InjectMocks\r\n    private SouvenirPuzzleService service;\r\n\r\n    private MedicalEvent sampleEvent;\r\n    private SouvenirPuzzle samplePuzzle;\r\n    private SouvenirSourceSummary sampleSouvenir;\r\n\r\n    @BeforeEach\r\n    void setUp() {\r\n        sampleEvent = MedicalEvent.builder()\r\n                .id(10L).title(\"Puzzle Mariage\").type(MedicalEventType.PUZZLE)\r\n                .difficulty(DifficultyLevel.MEDIUM).status(MedicalEventStatus.ACTIVE)\r\n                .patientId(4L).startDate(LocalDateTime.now())\r\n                .endDate(LocalDateTime.now().plusDays(7)).autoGenerated(false).build();\r\n\r\n        samplePuzzle = SouvenirPuzzle.builder()\r\n                .id(1L).medicalEvent(sampleEvent).souvenirEntryId(42L)\r\n                .patientId(4L).title(\"Puzzle Mariage 1985\")\r\n                .description(\"Photo du mariage\").difficulty(DifficultyLevel.MEDIUM)\r\n                .gridSize(4).timeLimitSeconds(300).maxHints(3)\r\n                .status(PuzzleStatus.ACTIVE).build();\r\n\r\n        sampleSouvenir = SouvenirSourceSummary.builder()\r\n                .id(42L).patientId(4L).mediaType(\"IMAGE\")\r\n                .mediaUrl(\"http://localhost:8086/files/mariage.jpg\")\r\n                .mediaTitle(\"Mariage 1985\").texte(\"Photo du mariage\").build();\r\n    }\r\n\r\n    // ── gridSize ──────────────────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"Calcul gridSize selon difficulté\")\r\n    class GridSize {\r\n\r\n        @Test\r\n        @DisplayName(\"EASY → gridSize = 3\")\r\n        void easy_gridSize3() {\r\n            PuzzleCreateRequest request = buildRequest(DifficultyLevel.EASY);\r\n            when(souvenirPuzzleRepository.existsBySouvenirEntryIdAndPatientId(42L, 4L)).thenReturn(false);\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(medicalEventRepository.save(any())).thenReturn(sampleEvent);\r\n            SouvenirPuzzle easyPuzzle = SouvenirPuzzle.builder().id(1L).medicalEvent(sampleEvent)\r\n                    .souvenirEntryId(42L).patientId(4L).title(\"T\").difficulty(DifficultyLevel.EASY)\r\n                    .gridSize(3).timeLimitSeconds(300).maxHints(3).status(PuzzleStatus.ACTIVE).build();\r\n            when(souvenirPuzzleRepository.save(any())).thenReturn(easyPuzzle);\r\n            when(puzzleSessionRepository.findByPuzzle_IdAndCompletedTrueOrderByScoreDescDurationSecondsAscFinishedAtAsc(any()))\r\n                    .thenReturn(List.of());\r\n\r\n            PuzzleResponse response = service.createPuzzle(request);\r\n\r\n            assertThat(response.getGridSize()).isEqualTo(3);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"MEDIUM → gridSize = 4\")\r\n        void medium_gridSize4() {\r\n            PuzzleCreateRequest request = buildRequest(DifficultyLevel.MEDIUM);\r\n            when(souvenirPuzzleRepository.existsBySouvenirEntryIdAndPatientId(42L, 4L)).thenReturn(false);\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(medicalEventRepository.save(any())).thenReturn(sampleEvent);\r\n            when(souvenirPuzzleRepository.save(any())).thenReturn(samplePuzzle);\r\n            when(puzzleSessionRepository.findByPuzzle_IdAndCompletedTrueOrderByScoreDescDurationSecondsAscFinishedAtAsc(any()))\r\n                    .thenReturn(List.of());\r\n\r\n            PuzzleResponse response = service.createPuzzle(request);\r\n\r\n            assertThat(response.getGridSize()).isEqualTo(4);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"HARD → gridSize = 5\")\r\n        void hard_gridSize5() {\r\n            PuzzleCreateRequest request = buildRequest(DifficultyLevel.HARD);\r\n            when(souvenirPuzzleRepository.existsBySouvenirEntryIdAndPatientId(42L, 4L)).thenReturn(false);\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(medicalEventRepository.save(any())).thenReturn(sampleEvent);\r\n            SouvenirPuzzle hardPuzzle = SouvenirPuzzle.builder().id(1L).medicalEvent(sampleEvent)\r\n                    .souvenirEntryId(42L).patientId(4L).title(\"T\").difficulty(DifficultyLevel.HARD)\r\n                    .gridSize(5).timeLimitSeconds(300).maxHints(3).status(PuzzleStatus.ACTIVE).build();\r\n            when(souvenirPuzzleRepository.save(any())).thenReturn(hardPuzzle);\r\n            when(puzzleSessionRepository.findByPuzzle_IdAndCompletedTrueOrderByScoreDescDurationSecondsAscFinishedAtAsc(any()))\r\n                    .thenReturn(List.of());\r\n\r\n            PuzzleResponse response = service.createPuzzle(request);\r\n\r\n            assertThat(response.getGridSize()).isEqualTo(5);\r\n        }\r\n    }\r\n\r\n    // ── createPuzzle ──────────────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"createPuzzle\")\r\n    class CreatePuzzle {\r\n\r\n        @Test\r\n        @DisplayName(\"Crée un puzzle avec succès\")\r\n        void createPuzzle_success() {\r\n            PuzzleCreateRequest request = buildRequest(DifficultyLevel.MEDIUM);\r\n            when(souvenirPuzzleRepository.existsBySouvenirEntryIdAndPatientId(42L, 4L)).thenReturn(false);\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(medicalEventRepository.save(any())).thenReturn(sampleEvent);\r\n            when(souvenirPuzzleRepository.save(any())).thenReturn(samplePuzzle);\r\n            when(puzzleSessionRepository.findByPuzzle_IdAndCompletedTrueOrderByScoreDescDurationSecondsAscFinishedAtAsc(any()))\r\n                    .thenReturn(List.of());\r\n\r\n            PuzzleResponse response = service.createPuzzle(request);\r\n\r\n            assertThat(response).isNotNull();\r\n            assertThat(response.getPatientId()).isEqualTo(4L);\r\n            verify(medicalEventRepository).save(argThat(e -> e.getType() == MedicalEventType.PUZZLE));\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si puzzle déjà existant pour ce souvenir/patient\")\r\n        void createPuzzle_alreadyExists_throws() {\r\n            PuzzleCreateRequest request = buildRequest(DifficultyLevel.MEDIUM);\r\n            when(souvenirPuzzleRepository.existsBySouvenirEntryIdAndPatientId(42L, 4L)).thenReturn(true);\r\n\r\n            assertThatThrownBy(() -> service.createPuzzle(request))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"already exists\");\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si souvenir n'est pas IMAGE\")\r\n        void createPuzzle_notImageSouvenir_throws() {\r\n            PuzzleCreateRequest request = buildRequest(DifficultyLevel.MEDIUM);\r\n            SouvenirSourceSummary audioSouvenir = SouvenirSourceSummary.builder()\r\n                    .id(42L).patientId(4L).mediaType(\"AUDIO\")\r\n                    .mediaUrl(\"http://audio.url\").build();\r\n\r\n            when(souvenirPuzzleRepository.existsBySouvenirEntryIdAndPatientId(42L, 4L)).thenReturn(false);\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(audioSouvenir);\r\n\r\n            assertThatThrownBy(() -> service.createPuzzle(request))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"IMAGE\");\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si souvenir n'appartient pas au patient\")\r\n        void createPuzzle_souvenirWrongPatient_throws() {\r\n            PuzzleCreateRequest request = buildRequest(DifficultyLevel.MEDIUM);\r\n            SouvenirSourceSummary wrongPatientSouvenir = SouvenirSourceSummary.builder()\r\n                    .id(42L).patientId(99L).mediaType(\"IMAGE\")\r\n                    .mediaUrl(\"http://img.url\").build();\r\n\r\n            when(souvenirPuzzleRepository.existsBySouvenirEntryIdAndPatientId(42L, 4L)).thenReturn(false);\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(wrongPatientSouvenir);\r\n\r\n            assertThatThrownBy(() -> service.createPuzzle(request))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"same patient\");\r\n        }\r\n    }\r\n\r\n    // ── startSession ──────────────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"startSession\")\r\n    class StartSession {\r\n\r\n        @Test\r\n        @DisplayName(\"Démarre une session avec succès\")\r\n        void startSession_success() {\r\n            PuzzleSession session = PuzzleSession.builder()\r\n                    .id(1L).puzzle(samplePuzzle).patientId(4L)\r\n                    .startedAt(LocalDateTime.now()).completed(false).abandoned(false)\r\n                    .movesCount(0).errorsCount(0).hintsUsed(0).completionPercent(0).build();\r\n\r\n            when(souvenirPuzzleRepository.findById(1L)).thenReturn(Optional.of(samplePuzzle));\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(puzzleSessionRepository.save(any())).thenReturn(session);\r\n\r\n            PuzzleSessionStartResponse response = service.startSession(1L, 4L);\r\n\r\n            assertThat(response.getSessionId()).isEqualTo(1L);\r\n            assertThat(response.getPatientId()).isEqualTo(4L);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si patient ne correspond pas au puzzle\")\r\n        void startSession_wrongPatient_throws() {\r\n            when(souvenirPuzzleRepository.findById(1L)).thenReturn(Optional.of(samplePuzzle));\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n\r\n            assertThatThrownBy(() -> service.startSession(1L, 99L))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"patient\");\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si puzzle INACTIVE\")\r\n        void startSession_inactivePuzzle_throws() {\r\n            samplePuzzle.setStatus(PuzzleStatus.INACTIVE);\r\n            when(souvenirPuzzleRepository.findById(1L)).thenReturn(Optional.of(samplePuzzle));\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n\r\n            assertThatThrownBy(() -> service.startSession(1L, 4L))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"inactive\");\r\n        }\r\n    }\r\n\r\n    // ── submitSession ─────────────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"submitSession — calcul du score\")\r\n    class SubmitSession {\r\n\r\n        private PuzzleSession openSession;\r\n\r\n        @BeforeEach\r\n        void setUpSession() {\r\n            openSession = PuzzleSession.builder()\r\n                    .id(5L).puzzle(samplePuzzle).patientId(4L)\r\n                    .startedAt(LocalDateTime.now().minusMinutes(4))\r\n                    .completed(false).abandoned(false)\r\n                    .movesCount(0).errorsCount(0).hintsUsed(0).completionPercent(0).build();\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Score > 0 pour session complétée sans erreur ni indice\")\r\n        void submitSession_perfectScore_positive() {\r\n            PuzzleSessionSubmitRequest request = PuzzleSessionSubmitRequest.builder()\r\n                    .patientId(4L).durationSeconds(200).movesCount(20)\r\n                    .errorsCount(0).hintsUsed(0).completionPercent(100)\r\n                    .completed(true).abandoned(false).build();\r\n\r\n            when(souvenirPuzzleRepository.findById(1L)).thenReturn(Optional.of(samplePuzzle));\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(puzzleSessionRepository.findById(5L)).thenReturn(Optional.of(openSession));\r\n            when(puzzleSessionRepository.save(any())).thenAnswer(inv -> inv.getArgument(0));\r\n            when(puzzleSessionRepository.findByPuzzle_IdAndCompletedTrueOrderByScoreDescDurationSecondsAscFinishedAtAsc(any()))\r\n                    .thenReturn(List.of());\r\n            when(participationRepository.existsByMedicalEventIdAndParticipantIdAndParticipantTypeAndParticipationDate(\r\n                    any(), any(), any(), any())).thenReturn(false);\r\n            when(participationRepository.save(any())).thenReturn(null);\r\n\r\n            PuzzleSessionResponse response = service.submitSession(1L, 5L, request);\r\n\r\n            assertThat(response.getScore()).isGreaterThan(0);\r\n            assertThat(response.getCompleted()).isTrue();\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève BusinessException si session déjà soumise\")\r\n        void submitSession_alreadySubmitted_throws() {\r\n            openSession.setFinishedAt(LocalDateTime.now());\r\n            PuzzleSessionSubmitRequest request = PuzzleSessionSubmitRequest.builder()\r\n                    .patientId(4L).completed(true).abandoned(false).build();\r\n\r\n            when(souvenirPuzzleRepository.findById(1L)).thenReturn(Optional.of(samplePuzzle));\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(puzzleSessionRepository.findById(5L)).thenReturn(Optional.of(openSession));\r\n\r\n            assertThatThrownBy(() -> service.submitSession(1L, 5L, request))\r\n                    .isInstanceOf(BusinessException.class)\r\n                    .hasMessageContaining(\"already been submitted\");\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Lève ResourceNotFoundException si session inconnue\")\r\n        void submitSession_sessionNotFound() {\r\n            PuzzleSessionSubmitRequest request = PuzzleSessionSubmitRequest.builder()\r\n                    .patientId(4L).completed(true).abandoned(false).build();\r\n\r\n            when(souvenirPuzzleRepository.findById(1L)).thenReturn(Optional.of(samplePuzzle));\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(puzzleSessionRepository.findById(99L)).thenReturn(Optional.empty());\r\n\r\n            assertThatThrownBy(() -> service.submitSession(1L, 99L, request))\r\n                    .isInstanceOf(ResourceNotFoundException.class);\r\n        }\r\n    }\r\n\r\n    // ── getPuzzlesByPatient ───────────────────────────────────────────────────\r\n\r\n    @Nested\r\n    @DisplayName(\"getPuzzlesByPatient\")\r\n    class GetPuzzlesByPatient {\r\n\r\n        @Test\r\n        @DisplayName(\"Retourne la liste des puzzles du patient\")\r\n        void getByPatient_returnsList() {\r\n            when(souvenirPuzzleRepository.findByPatientIdOrderByCreatedAtDesc(4L))\r\n                    .thenReturn(List.of(samplePuzzle));\r\n            when(restTemplate.getForObject(anyString(), eq(SouvenirSourceSummary.class))).thenReturn(sampleSouvenir);\r\n            when(puzzleSessionRepository.findByPuzzle_IdAndCompletedTrueOrderByScoreDescDurationSecondsAscFinishedAtAsc(any()))\r\n                    .thenReturn(List.of());\r\n\r\n            List<PuzzleResponse> result = service.getPuzzlesByPatient(4L);\r\n\r\n            assertThat(result).hasSize(1);\r\n            assertThat(result.get(0).getPatientId()).isEqualTo(4L);\r\n        }\r\n\r\n        @Test\r\n        @DisplayName(\"Retourne liste vide si aucun puzzle\")\r\n        void getByPatient_empty() {\r\n            when(souvenirPuzzleRepository.findByPatientIdOrderByCreatedAtDesc(99L)).thenReturn(List.of());\r\n\r\n            List<PuzzleResponse> result = service.getPuzzlesByPatient(99L);\r\n\r\n            assertThat(result).isEmpty();\r\n        }\r\n    }\r\n\r\n    // ── Helpers ───────────────────────────────────────────────────────────────\r\n\r\n    private PuzzleCreateRequest buildRequest(DifficultyLevel difficulty) {\r\n        return PuzzleCreateRequest.builder()\r\n                .souvenirEntryId(42L).patientId(4L)\r\n                .title(\"Puzzle Mariage 1985\").description(\"Photo du mariage\")\r\n                .difficulty(difficulty).timeLimitSeconds(300).maxHints(3).build();\r\n    }\r\n}\r\n
