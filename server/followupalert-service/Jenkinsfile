pipeline {
    agent any

    environment {
        MAVEN_HOME = '/usr/share/maven'
        JAVA_HOME = '/usr/lib/jvm/java-21-openjdk-amd64'
        SERVICE_NAME = 'followup-alert-service'
        DOCKER_REGISTRY = 'ghofraneidriss'
        IMAGE_TAG = "${BUILD_NUMBER}"
        SONARQUBE_TOKEN = 'squ_e358dcb6408302ceff87a82c69c97e8361f2ec57'
        GIT_SSL_NO_VERIFY = 'true'
        GIT_TRACE = '1'
        GIT_HTTP_LOW_SPEED_LIMIT = '0'
        GIT_HTTP_LOW_SPEED_TIME = '0'
        GIT_TERMINAL_PROMPT = 'false'
    }

    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout()
    }

    stages {
        stage('Checkout') {
            steps {
                echo '🔄 Checking out code...'
                cleanWs()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/jaaferFinal']],
                    userRemoteConfigs: [[url: 'https://github.com/ghofraneidriss/Esprit-PI-4SAE6-2026-mind-care.git']],
                    extensions: [[$class: 'CloneOption', depth: 1, noTags: false, reference: '', shallow: true]]
                ])
            }
        }

        stage('Build') {
            steps {
                echo '🔨 Building Maven project...'
                dir('server/followupalert-service') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                dir('server/followupalert-service') {
                    sh 'mvn test'
                    junit 'target/surefire-reports/*.xml'
                }
            }
        }

        stage('Package') {
            steps {
                echo '📦 Packaging application...'
                dir('server/followupalert-service') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '📦 Deploying artifact to Nexus Repository...'
                dir('server/followupalert-service') {
                    withCredentials([usernamePassword(
                        credentialsId: 'nexus-credentials',
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )]) {
                        sh '''
                            cat > /tmp/nexus-settings.xml << EOF
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
  <servers>
    <server>
      <id>mind-care-releases</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASS}</password>
    </server>
    <server>
      <id>mind-care-snapshots</id>
      <username>${NEXUS_USER}</username>
      <password>${NEXUS_PASS}</password>
    </server>
  </servers>
</settings>
EOF
                            mvn deploy \
                              -s /tmp/nexus-settings.xml \
                              -DskipTests \
                              -Dmaven.install.skip=true \
                              -Dorg.slf4j.simpleLogger.defaultLogLevel=info
                            echo "✅ Artifact deployed to Nexus"
                        '''
                    }
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '📊 Running SonarQube analysis...'
                dir('server/followupalert-service') {
                    sh '''
                        mvn sonar:sonar \
                          -Dsonar.projectKey=followup-alert-service \
                          -Dsonar.sources=src/main \
                          -Dsonar.tests=src/test \
                          -Dsonar.host.url=http://localhost:9000 \
                          -Dsonar.token=${SONARQUBE_TOKEN} \
                          || echo "SonarQube analysis skipped (server unavailable or auth failed)"
                    '''
                }
            }
        }

        stage('SonarQube Quality Gate') {
            steps {
                echo '🔎 Checking SonarQube Quality Gate...'
                dir('server/followupalert-service') {
                    sh '''
                        REPORT_FILE="target/sonar/report-task.txt"

                        if [ ! -f "$REPORT_FILE" ]; then
                            echo "⚠️  report-task.txt not found — SonarQube was skipped, Quality Gate bypassed"
                            exit 0
                        fi

                        TASK_ID=$(grep ceTaskId= $REPORT_FILE | cut -d= -f2)
                        echo "📋 CE Task ID: $TASK_ID"

                        # Poll until SonarQube finishes processing the analysis (max 60s)
                        MAX=12
                        I=0
                        STATUS="PENDING"
                        while [ "$STATUS" = "PENDING" ] || [ "$STATUS" = "IN_QUEUE" ]; do
                            if [ $I -ge $MAX ]; then
                                echo "⚠️  Timeout waiting for SonarQube — Quality Gate bypassed"
                                exit 0
                            fi
                            sleep 5
                            I=$((I + 1))
                            STATUS=$(curl -sf -u "${SONARQUBE_TOKEN}:" \
                                "http://localhost:9000/api/ce/task?id=${TASK_ID}" \
                                | grep -o '"status":"[^"]*"' | head -1 | cut -d'"' -f4)
                            echo "  ⏳ Analysis status: $STATUS (${I}/${MAX})"
                        done

                        # Fetch Quality Gate result
                        GATE=$(curl -sf -u "${SONARQUBE_TOKEN}:" \
                            "http://localhost:9000/api/qualitygates/project_status?projectKey=followup-alert-service" \
                            | grep -o '"status":"[^"]*"' | head -1 | cut -d'"' -f4)

                        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                        if [ "$GATE" = "OK" ]; then
                            echo "✅ Quality Gate PASSED"
                        elif [ "$GATE" = "ERROR" ]; then
                            echo "❌ Quality Gate FAILED — fix bugs/coverage before deploying"
                            echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                            exit 1
                        else
                            echo "⚠️  Quality Gate status: $GATE — continuing"
                        fi
                        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🐳 Building Docker image...'
                dir('server/followupalert-service') {
                    script {
                        sh '''
                            docker build \
                              -t ${DOCKER_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG} \
                              -t ${DOCKER_REGISTRY}/${SERVICE_NAME}:latest \
                              --label "build.number=${BUILD_NUMBER}" \
                              --label "git.commit=${GIT_COMMIT}" \
                              --label "jenkins.job=${JOB_NAME}" \
                              .
                        '''
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                echo '📤 Pushing Docker image to registry...'
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh '''
                            echo "${DOCKER_PASS}" | docker login -u "${DOCKER_USER}" --password-stdin
                            docker push ${DOCKER_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG}
                            docker push ${DOCKER_REGISTRY}/${SERVICE_NAME}:latest
                            docker logout
                            echo "✅ Docker images pushed successfully"
                        '''
                    }
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 Deploying followup-alert-service only...'
                script {
                    sh '''
                        cd ${WORKSPACE}
                        # Remove this service container by name and by compose label
                        # (label removal kills ghost containers from old runs)
                        # With zero existing containers docker-compose goes into CREATE path
                        # not RECREATE path — this avoids the ContainerConfig bug in v1.29.2
                        docker rm -f alzcare-followup-alert-service 2>/dev/null || true
                        docker ps -a --filter "label=com.docker.compose.service=followup-alert-service" -q | xargs -r docker rm -f 2>/dev/null || true
                        docker-compose up -d --no-deps followup-alert-service
                        sleep 10
                        docker-compose logs --tail=50 followup-alert-service
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                echo '❤️ Performing health checks...'
                script {
                    sh '''
                        MAX_RETRIES=30
                        RETRY_COUNT=0

                        while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
                            if nc -z localhost 8090 2>/dev/null; then
                                echo "✅ Service is healthy!"
                                exit 0
                            fi
                            RETRY_COUNT=$((RETRY_COUNT + 1))
                            echo "Health check attempt $RETRY_COUNT/$MAX_RETRIES..."
                            sleep 2
                        done

                        echo "❌ Service failed health check"
                        exit 1
                    '''
                }
            }
        }
    }

    post {
        always {
            echo '📝 Pipeline completed'
        }
        success {
            echo '✅ Pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}
