pipeline {
    agent any

    environment {
        SERVICE_NAME = 'lost-item-service'
        DOCKER_REGISTRY = 'ghofraneidriss'
        IMAGE_TAG = "${BUILD_NUMBER}"
        SONARQUBE_TOKEN = 'squ_e358dcb6408302ceff87a82c69c97e8361f2ec57'
        GIT_SSL_NO_VERIFY = 'true'
        GIT_TRACE = '1'
        GIT_HTTP_LOW_SPEED_LIMIT = '0'
        GIT_HTTP_LOW_SPEED_TIME = '0'
        GIT_TERMINAL_PROMPT = 'false'
    }

    options {
        timestamps()
        timeout(time: 1, unit: 'HOURS')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        skipDefaultCheckout()
    }

    stages {
        stage('Checkout') {
            steps {
                echo '🔄 Checking out code...'
                cleanWs()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/jaaferFinal']],
                    userRemoteConfigs: [[url: 'https://github.com/ghofraneidriss/Esprit-PI-4SAE6-2026-mind-care.git']],
                    extensions: [[$class: 'CloneOption', depth: 1, noTags: false, reference: '', shallow: true]]
                ])
            }
        }

        stage('Build') {
            steps {
                echo '🔨 Building Maven project...'
                dir('server/lost-item-service') {
                    sh 'mvn clean compile'
                }
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Running tests...'
                dir('server/lost-item-service') {
                    sh 'mvn test'
                }
            }
        }

        stage('Package') {
            steps {
                echo '📦 Packaging application...'
                dir('server/lost-item-service') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('Deploy to Nexus') {
            steps {
                echo '📦 Deploying artifact to Nexus Repository...'
                dir('server/lost-item-service') {
                    sh '''
                        mvn deploy \
                          -s ~/.m2/settings.xml \
                          -DskipTests \
                          -Dmaven.install.skip=true \
                          -Dorg.slf4j.simpleLogger.defaultLogLevel=info \
                          || echo "Nexus deployment skipped (server unavailable or auth failed)"
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {
            steps {
                echo '📊 Running SonarQube analysis...'
                dir('server/lost-item-service') {
                    sh '''
                        mvn sonar:sonar \
                          -Dsonar.projectKey=lost-item-service \
                          -Dsonar.sources=src/main \
                          -Dsonar.tests=src/test \
                          -Dsonar.host.url=http://localhost:9000 \
                          -Dsonar.token=${SONARQUBE_TOKEN} \
                          || echo "SonarQube analysis skipped (server unavailable or auth failed)"
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                echo '🐳 Building Docker image...'
                dir('server/lost-item-service') {
                    script {
                        sh '''
                            docker build \
                              -t ${DOCKER_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG} \
                              -t ${DOCKER_REGISTRY}/${SERVICE_NAME}:latest \
                              --label "build.number=${BUILD_NUMBER}" \
                              --label "git.commit=${GIT_COMMIT}" \
                              --label "jenkins.job=${JOB_NAME}" \
                              .
                        '''
                    }
                }
            }
        }

        stage('Push Docker Image') {
            steps {
                echo '📤 Pushing Docker image to registry...'
                script {
                    sh '''
                        docker push ${DOCKER_REGISTRY}/${SERVICE_NAME}:${IMAGE_TAG} || echo "Docker push skipped (no credentials configured)"
                        docker push ${DOCKER_REGISTRY}/${SERVICE_NAME}:latest || echo "Docker push skipped (no credentials configured)"
                    '''
                }
            }
        }

        stage('Deploy') {
            steps {
                echo '🚀 Deploying lost-item-service only...'
                script {
                    sh '''
                        # Kill every container related to this service — by label AND by name
                        docker ps -a --filter "label=com.docker.compose.service=lost-item-service" -q | xargs -r docker rm -f 2>/dev/null || true
                        docker rm -f alzcare-lost-item-service 2>/dev/null || true

                        # Ensure the network exists (created by docker-compose but may not exist on first run)
                        docker network create mindcare-network 2>/dev/null || true

                        # Pure docker run — zero docker-compose involvement
                        docker run -d \
                          --name alzcare-lost-item-service \
                          --network mindcare-network \
                          --restart unless-stopped \
                          -p 8082:8080 \
                          -p 9010:9010 \
                          -e SERVER_PORT=8080 \
                          -e SPRING_APPLICATION_NAME=lost-item-service \
                          -e "SPRING_DATASOURCE_URL=jdbc:mysql://mysql:3306/lost_item_db" \
                          -e SPRING_DATASOURCE_USERNAME=root \
                          -e "SPRING_DATASOURCE_PASSWORD=" \
                          -e SPRING_JPA_HIBERNATE_DDL_AUTO=update \
                          -e EUREKA_CLIENT_ENABLED=false \
                          -e EUREKA_CLIENT_REGISTER_WITH_EUREKA=false \
                          -e EUREKA_CLIENT_FETCH_REGISTRY=false \
                          ghofraneidriss/lost-item-service:latest

                        sleep 10
                        docker logs --tail=50 alzcare-lost-item-service
                    '''
                }
            }
        }

        stage('Health Check') {
            steps {
                echo '❤️ Performing health checks...'
                script {
                    sh '''
                        MAX_RETRIES=30
                        RETRY_COUNT=0

                        while [ $RETRY_COUNT -lt $MAX_RETRIES ]; do
                            if nc -z localhost 8082 2>/dev/null; then
                                echo "✅ Service is healthy!"
                                exit 0
                            fi
                            RETRY_COUNT=$((RETRY_COUNT + 1))
                            echo "Health check attempt $RETRY_COUNT/$MAX_RETRIES..."
                            sleep 2
                        done

                        echo "❌ Service failed health check"
                        exit 1
                    '''
                }
            }
        }
    }

    post {
        always {
            echo '📝 Pipeline completed'
        }
        success {
            echo '✅ Pipeline completed successfully!'
        }
        failure {
            echo '❌ Pipeline failed!'
        }
    }
}
